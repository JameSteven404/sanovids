{
  "name": "sanovids",
  "productName": "SanoVids",
  "private": true,
  "version": "0.5.0",
  "description": "SanoVids — dựng phim AI theo từng cảnh trên canvas",
  "author": {
    "name": "Nguyễn Giang Minh (Jame Steven)"
  },
  "homepage": "https://github.com/JameSteven404/sanovids-releases",
  "type": "module",
  "main": "electron/main.cjs",
  "sanovids": {
    "signers": [
      "7489ABFAC1A7CD23D5FFB0785CA7CAB414AE49ED"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "node scripts/update-notes.mjs && node scripts/third-party-notices.mjs --check && vite build && node scripts/electron-build.mjs --win nsis portable --publish never && node scripts/tidy-release.mjs",
    "tidy:release": "node scripts/tidy-release.mjs",
    "release:check": "node scripts/publish-release.mjs --dry-run",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.sanovids.app",
    "productName": "SanoVids",
    "executableName": "SanoVids",
    "copyright": "© 2026 Nguyễn Giang Minh (Jame Steven) · Đồng hành: Sano Group",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/sw.js",
      "!dist/workbox-*.js",
      "!dist/assets/*.woff",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "build/license-third-party.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "extraMetadata": {
      "author": {
        "name": "Nguyễn Giang Minh (Jame Steven)"
      }
    },
    "icon": "build/icon.png",
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": true,
      "signExts": [
        "ffmpeg.dll",
        "vk_swiftshader.dll",
        "vulkan-1.dll",
        "dxcompiler.dll"
      ],
      "signtoolOptions": {
        "certificateSha1": "7489ABFAC1A7CD23D5FFB0785CA7CAB414AE49ED",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": "Nguyễn Giang Minh (Jame Steven)"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SanoVids",
      "uninstallDisplayName": "SanoVids",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "language": "1066",
      "multiLanguageInstaller": true,
      "artifactName": "SanoVids-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license_vi.txt"
    },
    "portable": {
      "artifactName": "SanoVids-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JameSteven404",
        "repo": "sanovids-releases",
        "releaseType": "release"
      }
    ]
  }
}

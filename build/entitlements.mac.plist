<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the macOS build (package.json build.mac.entitlements AND entitlementsInherit): ad-hoc signed
  ("-"), hardened runtime on. Minimal on purpose: no camera / microphone / location / get-task-allow /
  dyld-environment / unsigned-executable-memory.
    - allow-jit: V8's JIT under the hardened runtime on Apple Silicon.
    - disable-library-validation: REQUIRED with an ad-hoc signature (no Team ID): without it the hardened runtime
      refuses to load SanoVids' own Electron Framework. Drop it once the app is signed with a Developer ID.
  scripts/mac-inspect.mjs checks the signed app carries exactly these two keys, both true (compared by meaning: the
  signature stores the plist without these comments).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>

{
  // Cloudflare Workers Static Assets: serves the built app (dist/) on <name>.<account>.workers.dev
  // and on any custom domain added later. `npm run deploy` builds and uploads.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanovids",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}

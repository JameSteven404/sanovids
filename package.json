{
  "name": "ban-dung-phim",
  "productName": "Bàn Dựng Phim",
  "private": true,
  "version": "0.1.0",
  "description": "Bàn Dựng Phim — dựng phim AI theo từng cảnh trên canvas",
  "author": "Bàn Dựng Phim",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "vn.bandungphim.app",
    "productName": "Bàn Dựng Phim",
    "executableName": "BanDungPhim",
    "copyright": "© 2026 Bàn Dựng Phim",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/sw.js",
      "!dist/workbox-*.js",
      "!dist/assets/*.woff",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "icon": "build/icon.png",
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bàn Dựng Phim",
      "uninstallDisplayName": "Bàn Dựng Phim",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "language": "1066",
      "multiLanguageInstaller": true,
      "artifactName": "Ban-Dung-Phim-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Ban-Dung-Phim-Portable-${version}.${ext}"
    }
  }
}

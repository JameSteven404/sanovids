{
  "name": "sanovids",
  "productName": "SanoVids",
  "private": true,
  "version": "1.1.0-beta.1",
  "description": "SanoVids — dựng phim AI theo từng cảnh trên canvas",
  "author": {
    "name": "Nguyễn Giang Minh (Jame Steven)"
  },
  "homepage": "https://github.com/JameSteven404/sanovids-releases",
  "type": "module",
  "main": "electron/main.cjs",
  "sanovids": {
    "signers": [
      "7489ABFAC1A7CD23D5FFB0785CA7CAB414AE49ED"
    ],
    "devUnlockKeys": [
      {
        "kid": 1,
        "alg": "ed25519",
        "key": "zXIkd1pwMbtjLdYs_sna98d68-mQ-zoWaW0bcZboBps"
      }
    ]
  },
  "scripts": {
    "perf:build": "vite build --mode perf",
    "perf:serve": "node scripts/perf/serve.mjs",
    "perf:run": "node scripts/perf/run-perf.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "stress": "node scripts/stress/run-stress.mjs",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "node scripts/update-notes.mjs && node scripts/third-party-notices.mjs --check && vite build && node scripts/electron-build.mjs --win nsis portable --publish never && node scripts/tidy-release.mjs",
    "dist:mac": "node scripts/update-notes.mjs && node scripts/third-party-notices.mjs --check && vite build && node scripts/electron-build.mjs --mac dmg zip --arm64 --publish never -c.directories.output=release/mac && node scripts/mac-inspect.mjs",
    "mac:fetch": "node scripts/fetch-mac-build.mjs",
    "tidy:release": "node scripts/tidy-release.mjs",
    "release:check": "node scripts/publish-release.mjs --dry-run",
    "release:publish": "node scripts/publish-release.mjs",
    "build:sano": "node scripts/build-sano.mjs",
    "dist:sano-agent": "node scripts/update-notes.mjs --sano-agent && node scripts/third-party-notices.mjs --check && vite build && node scripts/build-sano.mjs && node scripts/electron-build.mjs --config sano-agent/electron-builder.cjs --win nsis portable --publish never && node scripts/tidy-release.mjs --sano-agent",
    "release:check:sano-agent": "node scripts/publish-release.mjs --sano-agent --dry-run",
    "release:publish:sano-agent": "node scripts/publish-release.mjs --sano-agent"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.sanovids.app",
    "productName": "SanoVids",
    "executableName": "SanoVids",
    "copyright": "© 2026 Nguyễn Giang Minh (Jame Steven) · Đồng hành: Sano Group",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/sw.js",
      "!dist/workbox-*.js",
      "!dist/assets/*.woff",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "author": {
        "name": "Nguyễn Giang Minh (Jame Steven)"
      }
    },
    "icon": "build/icon.png",
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": true,
      "signExts": [
        "ffmpeg.dll",
        "vk_swiftshader.dll",
        "vulkan-1.dll",
        "dxcompiler.dll"
      ],
      "signtoolOptions": {
        "certificateSha1": "7489ABFAC1A7CD23D5FFB0785CA7CAB414AE49ED",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": "Nguyễn Giang Minh (Jame Steven)"
      },
      "extraFiles": [
        {
          "from": "LICENSE.txt",
          "to": "LICENSE.txt"
        },
        {
          "from": "build/license-third-party.txt",
          "to": "THIRD-PARTY-NOTICES.txt"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "forceCodeSigning": true,
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false,
      "category": "public.app-category.video",
      "minimumSystemVersion": "13.0",
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "artifactName": "SanoVids-Mac-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "LICENSE.txt",
          "to": "LICENSE.txt"
        },
        {
          "from": "build/license-third-party.txt",
          "to": "THIRD-PARTY-NOTICES.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "SanoVids lưu video và prompt vào thư mục bạn đã chọn trong Tài liệu.",
        "NSDesktopFolderUsageDescription": "SanoVids lưu video và prompt vào thư mục bạn đã chọn trên Màn hình nền.",
        "NSDownloadsFolderUsageDescription": "SanoVids lưu video và prompt vào thư mục Tải về hoặc thư mục bạn đã chọn trong đó.",
        "NSRemovableVolumesUsageDescription": "SanoVids lưu video vào thư mục bạn đã chọn trên ổ ngoài.",
        "NSNetworkVolumesUsageDescription": "SanoVids lưu video vào thư mục bạn đã chọn trên ổ mạng."
      }
    },
    "dmg": {
      "title": "SanoVids ${version}",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "sign": false,
      "writeUpdateInfo": false,
      "license": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SanoVids",
      "uninstallDisplayName": "SanoVids",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "language": "1066",
      "multiLanguageInstaller": true,
      "artifactName": "SanoVids-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license_vi.txt"
    },
    "portable": {
      "artifactName": "SanoVids-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JameSteven404",
        "repo": "sanovids-releases",
        "releaseType": "release"
      }
    ]
  }
}
